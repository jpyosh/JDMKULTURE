# Copy to .env (gitignored) for `npm run dev` and `npm run db`. Set the same values in Vercel.

# Supabase → Connect → Session pooler connection string. Server-only secret.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Supabase → Project Settings → API. The anon key is public by design; never use the service-role key.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key

PORT=3000
