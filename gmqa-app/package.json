  "description": "JDM Kulture GM QA - Carwash Ops Console (Daily Log, Pricing Matrix, EOD Reconciliation, Payroll)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
